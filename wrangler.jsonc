{
  // CityPulse on Cloudflare: static assets (the site and every town's ready model, built by scripts/export-static.js)
  // plus one Worker for /api/*, the share pages, and the AI. See docs/CLOUDFLARE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citypulse",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/export-static.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/s/*", "/media/*", "/robots.txt", "/sitemap.xml", "/openapi.json"]
  },
  "kv_namespaces": [{ "binding": "STATE", "id": "eff6dccfbefd4bdb89a4f1fe18681214" }],
  "d1_databases": [{ "binding": "DB", "database_name": "citypulse", "database_id": "07bf59b3-760c-4786-bae6-8d81be4f7c59" }],
  "ratelimits": [{ "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": true }
}
